# Copy to examples/.env and fill in your values.
# chmod 600 examples/.env  — keep this file private.

# Tailscale OAuth client (see README). Scopes: auth_keys, policy_file:read.
# The client must carry the same tag you provision with (EXIT_TAG below).
# Each run mints its own single-use, short-lived auth key from these.
TS_OAUTH_CLIENT_ID=kxxxxxxxxxxxCNTRL
TS_OAUTH_CLIENT_SECRET=tskey-client-xxxxxxxxxxxxxxxx

# Alternative to the OAuth client: a pre-made auth key. Takes precedence over
# the credentials above, and disables automatic minting.
# TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxx

# Hosting provider token, for the `create` and `destroy` subcommands.
# Uncomment whichever provider you use.
# DIGITALOCEAN_TOKEN=dop_v1_xxxxxxxxxxxxxxxx
# HCLOUD_TOKEN=xxxxxxxxxxxxxxxx

# SSH target for the `ssh` subcommand.
EXIT_HOST=root@1.2.3.4

# Tailscale hostname for this exit node.
EXIT_HOSTNAME=insta-exit-1

# Tag to advertise (must match your ACL autoApprovers entry).
EXIT_TAG=tag:exit
