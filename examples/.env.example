# Copy to examples/.env and fill in your values.
# chmod 600 examples/.env  — keep this file private.

# Tailscale auth key (Ephemeral + Reusable + tagged, see README).
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxx

# SSH target for the `ssh` subcommand.
EXIT_HOST=root@1.2.3.4

# Tailscale hostname for this exit node.
EXIT_HOSTNAME=insta-exit-1

# Tag to advertise (must match your ACL autoApprovers entry).
EXIT_TAG=tag:exit
