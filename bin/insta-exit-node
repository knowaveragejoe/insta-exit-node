#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""
insta-exit-node — stand up a Tailscale exit node on a Debian/Ubuntu VM.

Subcommands:
  create      Create a VM at a provider and provision it into an exit node.
  destroy     Destroy a VM at a provider.
  ssh         Provision an already-running VM over SSH.
  cloud-init  Emit a cloud-init user-data document that self-provisions on first boot.
  authkey     Mint a short-lived auth key and print it.

If no auth key is supplied, one is minted through the Tailscale API using OAuth
client credentials. The client secret stays on this machine: it is never written
into user-data, sent to the target host, or logged.
"""
import argparse
import base64
import json
import os
import shlex
import subprocess
import sys
from pathlib import Path


REPO_ROOT = Path(__file__).resolve().parent.parent
PROVISION_PY = REPO_ROOT / "provision.py"

sys.path.insert(0, str(REPO_ROOT))
import providers  # noqa: E402  — needs REPO_ROOT on sys.path first
import tsapi  # noqa: E402


def log(msg):
    """Progress goes to stderr so stdout stays usable for piped output."""
    print(f"[insta-exit-node] {msg}", file=sys.stderr)


def api_token(args):
    """Return a Tailscale API access token, or None if no credentials were given."""
    api_key = getattr(args, "api_key", None) or os.environ.get("TS_API_KEY", "")
    if api_key:
        return api_key
    client_id = getattr(args, "oauth_client_id", None) or os.environ.get(
        "TS_OAUTH_CLIENT_ID", ""
    )
    client_secret = getattr(args, "oauth_client_secret", None) or os.environ.get(
        "TS_OAUTH_CLIENT_SECRET", ""
    )
    if client_id and client_secret:
        log("Exchanging OAuth client credentials for an access token...")
        return tsapi.exchange_oauth_token(client_id, client_secret)
    if client_id or client_secret:
        sys.exit(
            "Error: an OAuth client needs both an ID and a secret "
            "(--oauth-client-id / --oauth-client-secret, or "
            "TS_OAUTH_CLIENT_ID / TS_OAUTH_CLIENT_SECRET)."
        )
    return None


def preflight(token, tailnet, tags):
    """Verify the tailnet policy before anything gets provisioned."""
    log("Checking tailnet policy...")
    try:
        policy = tsapi.get_policy_file(token, tailnet=tailnet)
    except tsapi.TailscaleAPIError as exc:
        # Usually just a token without policy_file:read. Not worth blocking on —
        # the on-VM approval check still catches an unapproved node later.
        log(f"Warning: could not read policy file ({exc}); skipping preflight.")
        return
    problems = tsapi.check_acl(policy, tags)
    if problems:
        sys.exit(
            "Error: your tailnet policy is missing entries this exit node needs.\n\n"
            + "\n\n".join(problems)
            + "\n\nNothing was provisioned. Update Access controls and re-run, or "
            "pass --no-preflight to skip this check."
        )
    log(f"Policy OK ({', '.join(tags)} auto-approved as an exit node).")


def mint_authkey(args):
    """Mint a short-lived single-use auth key through the Tailscale API."""
    try:
        token = api_token(args)
    except tsapi.TailscaleAPIError as exc:
        sys.exit(f"Error: OAuth token exchange failed: {exc}")
    if not token:
        sys.exit(
            "Error: no auth key, and no API credentials to mint one.\n"
            "  Supply a key with --authkey, --authkey-file or $TS_AUTHKEY, or set\n"
            "  TS_OAUTH_CLIENT_ID and TS_OAUTH_CLIENT_SECRET to mint keys automatically."
        )
    tags = getattr(args, "tags", []) or []
    if not tags:
        sys.exit(
            "Error: --tag is required when minting a key. Keys created through the "
            "API are owned by the tailnet, and Tailscale requires them to be tagged."
        )
    if not getattr(args, "no_preflight", False):
        preflight(token, args.tailnet, tags)
    log(f"Minting auth key (single-use, ephemeral, expires in {args.key_expiry}s)...")
    try:
        return tsapi.create_auth_key(
            token,
            tags=tags,
            hostname=getattr(args, "hostname", None),
            expiry_seconds=args.key_expiry,
            tailnet=args.tailnet,
        )
    except tsapi.TailscaleAPIError as exc:
        sys.exit(f"Error: could not create auth key: {exc}")


def resolve_authkey(args):
    if getattr(args, "authkey", None):
        return args.authkey
    if getattr(args, "authkey_file", None):
        return Path(args.authkey_file).read_text().strip()
    env_val = os.environ.get("TS_AUTHKEY", "")
    if env_val:
        return env_val
    return mint_authkey(args)


def build_prov_args(args):
    """Build provisioner CLI args (authkey excluded — handled separately per transport)."""
    prov_args = []
    if getattr(args, "hostname", None):
        prov_args += ["--hostname", args.hostname]
    for tag in getattr(args, "tags", []):
        prov_args += ["--tag", tag]
    for route in getattr(args, "routes", []):
        prov_args += ["--advertise-route", route]
    if not getattr(args, "ssh", True):
        prov_args.append("--no-ssh")
    if not getattr(args, "ipv6", True):
        prov_args.append("--no-ipv6-forwarding")
    if getattr(args, "reset", False):
        prov_args.append("--reset")
    return prov_args


def cmd_ssh(args):
    host = args.host
    ssh_key = getattr(args, "ssh_key", None)

    # Check local prerequisites before resolving the key: resolving may mint one,
    # and a key burned on a run that then fails locally is wasted.
    if not PROVISION_PY.exists():
        sys.exit(f"Error: provision.py not found at {PROVISION_PY}")

    authkey = resolve_authkey(args)

    ssh_opts = ["-o", "StrictHostKeyChecking=accept-new", "-o", "BatchMode=yes"]
    if ssh_key:
        ssh_opts += ["-i", ssh_key]

    scp_cmd = ["scp"] + ssh_opts + [str(PROVISION_PY), f"{host}:/tmp/provision.py"]
    log(f"Copying provision.py to {host}...")
    subprocess.run(scp_cmd, check=True)

    prov_args = build_prov_args(args) + ["--authkey-file", "/tmp/.ts-authkey"]
    prov_cmd = "sudo python3 /tmp/provision.py " + " ".join(
        shlex.quote(a) for a in prov_args
    )

    # Pipe authkey via stdin so it never appears in ps or shell history on the target.
    # Remote sequence: write key → run provisioner → shred key (cleanup even on failure).
    # umask 077 first: the key file must never exist world-readable, not even for the
    # instant between creation and a follow-up chmod.
    remote_sh = (
        "umask 077 && "
        "cat > /tmp/.ts-authkey && "
        f"{prov_cmd}; "
        "rc=$?; "
        "shred -u /tmp/.ts-authkey 2>/dev/null || rm -f /tmp/.ts-authkey; "
        "exit $rc"
    )

    ssh_cmd = ["ssh"] + ssh_opts + [host, remote_sh]
    log(f"Running provisioner on {host}...")
    result = subprocess.run(ssh_cmd, input=authkey.encode())
    sys.exit(result.returncode)


def render_cloud_config(args):
    """Build the #cloud-config document, minting an auth key if none was given."""
    if not PROVISION_PY.exists():
        sys.exit(f"Error: provision.py not found at {PROVISION_PY}")

    authkey = resolve_authkey(args)

    provision_b64 = base64.b64encode(PROVISION_PY.read_bytes()).decode()
    authkey_b64 = base64.b64encode(authkey.encode()).decode()

    prov_args = ["--authkey-file", "/root/.ts-authkey"] + build_prov_args(args)
    runcmd_list = ["python3", "/usr/local/sbin/provision.py"] + prov_args
    # JSON is a subset of YAML 1.2, so json.dumps produces a correctly escaped
    # double-quoted YAML scalar for any input — no hand-rolled quoting needed.
    runcmd_item = "  - [" + ", ".join(json.dumps(a) for a in runcmd_list) + "]"

    cloud_config = f"""#cloud-config
write_files:
  - path: /usr/local/sbin/provision.py
    permissions: '0755'
    owner: root:root
    encoding: b64
    content: {provision_b64}
  - path: /root/.ts-authkey
    permissions: '0600'
    owner: root:root
    encoding: b64
    content: {authkey_b64}
runcmd:
{runcmd_item}
  - shred -u /root/.ts-authkey 2>/dev/null || rm -f /root/.ts-authkey
"""
    return cloud_config


def cmd_cloud_init(args):
    print(render_cloud_config(args), end="")


def cmd_create(args):
    """Create a VM at a provider that provisions itself into an exit node."""
    try:
        provider = providers.get_provider(args.provider, args.provider_token)
    except providers.ProviderError as exc:
        sys.exit(f"Error: {exc}")

    name = args.name or args.hostname or "insta-exit-1"
    region = args.region or provider.defaults["region"]
    size = args.size or provider.defaults["size"]
    image = args.image or provider.defaults["image"]
    # Keep the tailnet node name and the VM name the same, so `destroy --name`
    # and the Tailscale admin console agree.
    args.hostname = args.hostname or name

    # Renders the user-data, which mints the key and runs the policy preflight.
    # Done before touching the provider so a policy problem costs nothing.
    user_data = render_cloud_config(args)

    log(f"Creating {provider.name} VM {name!r} ({size}, {image}, {region})...")
    try:
        server = provider.create(
            name=name,
            region=region,
            size=size,
            image=image,
            ssh_keys=args.ssh_keys,
            user_data=user_data,
        )
        if not server["ip"]:
            log("Waiting for a public IP...")
            server = provider.wait_for_ip(server["id"], timeout=args.wait_timeout)
    except providers.ProviderError as exc:
        sys.exit(f"Error: {exc}")

    log(f"Created {server['name']} (id {server['id']}) at {server['ip']}")
    log("Cloud-init is provisioning Tailscale; the node should appear in 60-90s.")
    log(f"Tear down with: insta-exit-node destroy --provider {provider.name} --name {name}")
    print(server["ip"])


def cmd_destroy(args):
    """Destroy a VM at a provider."""
    try:
        provider = providers.get_provider(args.provider, args.provider_token)
        matches = provider.find(args.name)
    except providers.ProviderError as exc:
        sys.exit(f"Error: {exc}")

    if not matches:
        sys.exit(f"Error: no {provider.name} VM named {args.name!r}.")

    listing = ", ".join(
        f"{m['name']} (id {m['id']}, {m['ip'] or 'no IP'})" for m in matches
    )
    if not args.yes:
        # Destroying a VM is irreversible, so never do it unattended by accident.
        if not sys.stdin.isatty():
            sys.exit(
                f"Error: refusing to destroy {listing} without --yes "
                "(stdin is not a terminal)."
            )
        print(f"About to permanently destroy: {listing}", file=sys.stderr)
        if input("Type 'yes' to confirm: ").strip().lower() != "yes":
            sys.exit("Aborted; nothing was destroyed.")

    for match in matches:
        log(f"Destroying {match['name']} (id {match['id']})...")
        try:
            provider.delete(match["id"])
        except providers.ProviderError as exc:
            sys.exit(f"Error: {exc}")
    log("Done. Ephemeral Tailscale nodes leave the console within a few minutes.")


def add_provider_args(p):
    p.add_argument(
        "--provider",
        required=True,
        choices=sorted(providers.PROVIDERS),
        help="Hosting provider",
    )
    p.add_argument(
        "--provider-token",
        metavar="TOKEN",
        help="Provider API token (default: from the provider's env var)",
    )


def cmd_authkey(args):
    """Mint a key and print it to stdout, for scripting."""
    print(mint_authkey(args))


def add_shared_args(p):
    key_group = p.add_mutually_exclusive_group()
    key_group.add_argument(
        "--authkey", help="Tailscale auth key (or TS_AUTHKEY env var)"
    )
    key_group.add_argument(
        "--authkey-file", metavar="PATH", help="Path to file containing the auth key"
    )
    p.add_argument("--hostname", default=None, help="Tailscale node hostname")
    p.add_argument(
        "--tag",
        action="append",
        dest="tags",
        default=[],
        metavar="TAG",
        help="Advertise tag (repeatable, e.g. --tag tag:exit)",
    )
    p.add_argument(
        "--advertise-route",
        action="append",
        dest="routes",
        default=[],
        metavar="CIDR",
        help="Subnet route to advertise (repeatable)",
    )
    p.add_argument(
        "--no-ssh",
        action="store_false",
        dest="ssh",
        help="Disable Tailscale SSH (enabled by default)",
    )
    p.add_argument(
        "--no-ipv6-forwarding",
        action="store_false",
        dest="ipv6",
        help="Disable IPv6 forwarding (enabled by default)",
    )
    p.add_argument(
        "--reset", action="store_true", help="Pass --reset to tailscale up on the target"
    )
    p.add_argument(
        "--oauth-client-id",
        metavar="ID",
        help="Tailscale OAuth client ID (or TS_OAUTH_CLIENT_ID)",
    )
    p.add_argument(
        "--oauth-client-secret",
        metavar="SECRET",
        help="Tailscale OAuth client secret (or TS_OAUTH_CLIENT_SECRET)",
    )
    p.add_argument(
        "--api-key",
        metavar="KEY",
        help="Tailscale API access token, used instead of an OAuth client (or TS_API_KEY)",
    )
    p.add_argument(
        "--tailnet",
        default=tsapi.DEFAULT_TAILNET,
        help="Tailnet to operate on (default: '-', this token's default tailnet)",
    )
    p.add_argument(
        "--key-expiry",
        type=int,
        default=tsapi.DEFAULT_KEY_EXPIRY,
        metavar="SECONDS",
        help=f"Lifetime of a minted auth key (default: {tsapi.DEFAULT_KEY_EXPIRY})",
    )
    p.add_argument(
        "--no-preflight",
        action="store_true",
        help="Skip the tailnet policy check before minting a key",
    )
    p.set_defaults(ssh=True, ipv6=True)


def main():
    parser = argparse.ArgumentParser(
        description="Stand up a Tailscale exit node on a Debian/Ubuntu VM.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
examples:
  # Create a VM and provision it, end to end
  export TS_OAUTH_CLIENT_ID=... TS_OAUTH_CLIENT_SECRET=tskey-client-...
  export DIGITALOCEAN_TOKEN=dop_v1_...
  uv run bin/insta-exit-node create --provider digitalocean --tag tag:exit
  uv run bin/insta-exit-node destroy --provider digitalocean --name insta-exit-1

  # Provision a VM you already have
  uv run bin/insta-exit-node ssh --host root@1.2.3.4 --hostname my-exit --tag tag:exit

  # Generate cloud-init user-data (pipe into your provider's CLI)
  uv run bin/insta-exit-node cloud-init --hostname my-exit --tag tag:exit > userdata.yaml

  # Bring your own key instead
  export TS_AUTHKEY=tskey-auth-...
  uv run bin/insta-exit-node ssh --host root@1.2.3.4 --tag tag:exit
""",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    ssh_p = subparsers.add_parser("ssh", help="Provision an already-running VM via SSH.")
    ssh_p.add_argument(
        "--host",
        required=True,
        metavar="USER@IP",
        help="SSH target, e.g. root@1.2.3.4 or ubuntu@1.2.3.4",
    )
    ssh_p.add_argument(
        "--ssh-key", metavar="PATH", help="Path to SSH private key (optional)"
    )
    add_shared_args(ssh_p)

    ci_p = subparsers.add_parser(
        "cloud-init",
        help="Emit a cloud-init user-data document that self-provisions on first boot.",
    )
    add_shared_args(ci_p)

    key_p = subparsers.add_parser(
        "authkey",
        help="Mint a short-lived auth key and print it to stdout.",
    )
    add_shared_args(key_p)

    create_p = subparsers.add_parser(
        "create",
        help="Create a VM at a provider that provisions itself into an exit node.",
    )
    add_provider_args(create_p)
    create_p.add_argument(
        "--name", help="VM name (default: --hostname, else insta-exit-1)"
    )
    create_p.add_argument("--region", help="Region/location (default: provider's)")
    create_p.add_argument("--size", help="Instance type (default: provider's)")
    create_p.add_argument("--image", help="OS image (default: provider's Ubuntu LTS)")
    create_p.add_argument(
        "--ssh-key",
        action="append",
        dest="ssh_keys",
        default=[],
        metavar="KEY",
        help="SSH key already registered with the provider, by ID or name (repeatable)",
    )
    create_p.add_argument(
        "--wait-timeout",
        type=int,
        default=180,
        metavar="SECONDS",
        help="How long to wait for a public IP (default: 180)",
    )
    add_shared_args(create_p)

    destroy_p = subparsers.add_parser("destroy", help="Destroy a VM at a provider.")
    add_provider_args(destroy_p)
    destroy_p.add_argument("--name", required=True, help="VM name to destroy")
    destroy_p.add_argument(
        "--yes", action="store_true", help="Skip the confirmation prompt"
    )

    args = parser.parse_args()
    if args.command == "ssh":
        cmd_ssh(args)
    elif args.command == "cloud-init":
        cmd_cloud_init(args)
    elif args.command == "authkey":
        cmd_authkey(args)
    elif args.command == "create":
        cmd_create(args)
    elif args.command == "destroy":
        cmd_destroy(args)


if __name__ == "__main__":
    main()
